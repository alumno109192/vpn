FROM ubuntu:24.04

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    xvfb \
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5dbus5 \
    libqt5network5 \
    libqt5printsupport5 \
    libgl1-mesa-dri \
    libegl1 \
    libegl-mesa0 \
    libxkbcommon-x11-0 \
    upx-ucl \
    libfontconfig1 \
    libfreetype6 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libdbus-1-3 \
    libglib2.0-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Establecer directorio de trabajo
WORKDIR /app

# Copiar archivos de la aplicación
COPY . .

# Crear entorno virtual e instalar dependencias
RUN python3 -m venv venv && \
    . venv/bin/activate && \
    pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install pyinstaller>=5.0

# Script de build
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🔨 Iniciando build de ejecutable Linux..."\n\
\n\
# Activar entorno virtual\n\
. venv/bin/activate\n\
\n\
# Configurar display virtual\n\
export DISPLAY=:99.0\n\
Xvfb :99 -screen 0 1024x768x24 > /dev/null 2>&1 &\n\
sleep 3\n\
\n\
# Crear versión\n\
VERSION=$(date +%Y.%m.%d)\n\
sed -i "s/current_version = \"1.0.0\"/current_version = \"$VERSION\"/" Main.py\n\
\n\
# Build con PyInstaller usando .spec\n\
echo "📦 Ejecutando PyInstaller..."\n\
python3 -m PyInstaller VPN-Manager.spec\n\
\n\
# Verificar ejecutable\n\
if [ -f "dist/VPN-Manager" ]; then\n\
    echo "✅ Ejecutable creado: dist/VPN-Manager"\n\
    file dist/VPN-Manager\n\
    ls -lah dist/VPN-Manager\n\
else\n\
    echo "❌ Error: No se creó el ejecutable"\n\
    ls -la dist/\n\
    exit 1\n\
fi\n\
\n\
# Comprimir con UPX\n\
echo "🗜️ Comprimiendo con UPX..."\n\
upx --best --lzma dist/VPN-Manager || echo "⚠️ UPX falló, continuando..."\n\
\n\
# Renombrar con versión\n\
cp dist/VPN-Manager VPN-Manager-Linux-$VERSION\n\
chmod +x VPN-Manager-Linux-$VERSION\n\
\n\
# Generar checksum\n\
sha256sum VPN-Manager-Linux-$VERSION > VPN-Manager-Linux-$VERSION.sha256\n\
\n\
echo "✅ Build completado exitosamente!"\n\
echo "📁 Archivos generados:"\n\
ls -lah VPN-Manager-Linux-*\n\
' > build.sh && chmod +x build.sh

CMD ["./build.sh"]
